# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Required only for `npm run seed:media` (uploads /media binaries to the
# contenidos Storage bucket). Get from project settings > API > service_role.
# Local default key prints via `npx supabase status`.
# DO NOT commit a real service role key — it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Supabase Edge Function secrets ────────────────────────────────────────────
# These are NOT set in .env.local. Store them as Supabase project secrets:
#   npx supabase secrets set RESEND_API_KEY=re_...
#   npx supabase secrets set RESEND_FROM_ADDRESS="Cliente <onboarding@resend.dev>"
#
# RESEND_API_KEY — Resend API key (get from https://resend.com/api-keys)
# RESEND_FROM_ADDRESS — Sender address (Phase 1 sandbox: onboarding@resend.dev;
#                       Phase 2 will use the verified custom domain)
#
# Set in Supabase project secrets, NOT in .env.local
# RESEND_API_KEY=re_...
# RESEND_FROM_ADDRESS=Cliente <onboarding@resend.dev>
